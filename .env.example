# ==============================================================================
# SCHOLARSHIP RADAR - ENVIRONMENT CONFIGURATION TEMPLATE
# Do NOT place real secrets in this file. Copy to .env for local development.
# ==============================================================================

# APP_URL: The canonical URL where this application is hosted.
# Used for sitemap.xml, OpenGraph canonical tags, and email notifications.
APP_URL="https://scholarshipradar.org"

# PORT: The port the backend server runs on (defaults to 3000)
PORT=3000

# SUPABASE POSTGRESQL DATABASE INTEGRATION (OPTIONAL)
# When connecting directly to Supabase cloud instance:
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-public-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# GOOGLE ADSENSE INTEGRATION
# Your AdSense publisher account ID
VITE_ADSENSE_PUBLISHER_ID="ca-pub-9842107452189400"

# GOOGLE ANALYTICS & SEARCH CONSOLE
VITE_GA_MEASUREMENT_ID="G-SRADAR2026"
VITE_GOOGLE_SEARCH_CONSOLE_TAG="google-site-verification=sr_scholarship_radar_auth_key_2026"
